{
  "name": "college-website-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cp index.src.html index.html 2>/dev/null || true; vite",
    "build": "cp index.src.html index.html 2>/dev/null || true; vite build && cp -r dist/* . && cp -r public/* . && cp dist/assets/*.js assets/index.js 2>/dev/null || true",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-10000}"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.1"
  }
}